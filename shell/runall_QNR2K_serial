#!/usr/bin/env zsh

all="$@"
[[ -z "$all" ]] && { print -u2 -- 'No directories given !' ; exit 1}

setopt extendedglob
base="$(pwd)"

ncpu=$(nproc)
: ${OMP_NUM_THREADS:=$ncpu}
: ${OPENBLAS_NUM_THREADS:=1}
export OMP_NUM_THREADS OPENBLAS_NUM_THREADS

typeset -A names=( singlet 1 doublet 2 triplet 3 quartet 4 )

for dir in ${=all} ; do
  cd "$dir" || continue
  for item in *let.??  ; do
    print "=============================="
    print --  "Running $item in $dir"
    print "=============================="
    ./"$item" || continue
    cd output
    mkdir -p all
    for f in *let.??/output/*.kmat ; do
    basef="${f:t}"            # N_.spinmult.irrep_R2K.kmat
    geom="${basef%%_*}"       # N
    sym="${${basef#*_.}%%_*}" # spinmult.irrep
    cp -- "$f" "all/K-matrix.geom${geom}.${sym}" # all/K-matrix.geomN.spinmult.irrep
    done
    cd ..
  done
  cd "$base"
done
